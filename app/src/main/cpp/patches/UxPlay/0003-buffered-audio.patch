+#ifdef TELIK_AIRPLAY2
+/* Buffered audio (type 103). Packets arrive ahead of time on a TCP connection. */
+static void
+telik_buffered_audio_sink(void *cls, const uint8_t *data, int len, uint32_t rtp_ts, uint32_t seq, uint64_t remote_ns)
+{
+    raop_conn_t *conn = cls;
+    raop_t *raop = conn->raop;
+    audio_decode_struct audio_data;
+    uint64_t now = raop_ntp_get_local_time();
+    static unsigned count = 0;
+    if (!raop->callbacks.audio_process) return;
+    audio_data.rtp_time = rtp_ts;
+    audio_data.seqnum = (unsigned short) seq;
+    audio_data.data_len = len;
+    audio_data.data = (unsigned char *) data;
+    audio_data.ct = conn->buffered_ct;
+    audio_data.sync_status = 0;
+    audio_data.ntp_time_remote = remote_ns;
+    audio_data.ntp_time_local = conn->raop_ntp ? raop_ntp_convert_remote_time(conn->raop_ntp, remote_ns) : 0;
+    /* The lead is how far ahead of the clock a packet plays. Drift shows as a trend in this number. */
+    if ((count++ % 256) == 0) {
+        logger_log(raop->logger, LOGGER_INFO, "airplay2: buffered audio packet %u, seq %u, lead %.3f s",
+                   count, seq, audio_data.ntp_time_local ? ((double) ((int64_t) audio_data.ntp_time_local - (int64_t) now)) / SECOND_IN_NSECS : 0.0);
+    }
+    raop->callbacks.audio_process(raop->callbacks.cls, conn->raop_ntp, &audio_data);
+}
+
+static void
+raop_handler_set_rate_anchor_time(raop_conn_t *conn,
+                                  http_request_t *request, http_response_t *response,
+                                  char **response_data, int *response_datalen)
+{
+    raop_t *raop = conn->raop;
+    int data_len = 0;
+    const char *data = http_request_get_data(request, &data_len);
+    plist_t root = NULL;
+    double rate = 0.0;
+    uint64_t rtp_time = 0, secs = 0, frac = 0;
+    if (data_len) plist_from_bin(data, data_len, &root);
+    if (!root || !conn->buffered) {
+        logger_log(raop->logger, LOGGER_DEBUG, "airplay2: SETRATEANCHORTIME without buffered audio");
+        plist_free(root);
+        return;
+    }
+    plist_get_real_val(plist_dict_get_item(root, "rate"), &rate);
+    plist_get_uint_val(plist_dict_get_item(root, "rtpTime"), &rtp_time);
+    plist_get_uint_val(plist_dict_get_item(root, "networkTimeSecs"), &secs);
+    plist_get_uint_val(plist_dict_get_item(root, "networkTimeFrac"), &frac);
+    plist_free(root);
+    /* The fraction counts 1/2^64 s. Keep the top 32 bits for nanoseconds. */
+    uint64_t remote_ns = secs * SECOND_IN_NSECS + ((frac >> 32) * SECOND_IN_NSECS >> 32);
+    logger_log(raop->logger, LOGGER_INFO, "airplay2: rate %.1f, rtp %llu, network time %llu ns", rate,
+               (unsigned long long) rtp_time, (unsigned long long) remote_ns);
+    telik_buffered_set_anchor(conn->buffered, (uint32_t) rtp_time, remote_ns, rate > 0.0);
+    if (rate <= 0.0 && raop->callbacks.audio_flush) {
+        raop->callbacks.audio_flush(raop->callbacks.cls);
+    }
+}
+
+static void
+raop_handler_flush_buffered(raop_conn_t *conn,
+                            http_request_t *request, http_response_t *response,
+                            char **response_data, int *response_datalen)
+{
+    raop_t *raop = conn->raop;
+    logger_log(raop->logger, LOGGER_INFO, "airplay2: FLUSHBUFFERED");
+    if (conn->buffered) telik_buffered_flush(conn->buffered);
+    if (raop->callbacks.audio_flush) {
+        raop->callbacks.audio_flush(raop->callbacks.cls);
+    }
+}
+#endif
